<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main app theme AFTER splash -->
    <style name="Theme.SampleSizeCalculator" parent="android:Theme.Material.Light.NoActionBar">
        <!-- You can customize colors etc here if you want -->
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.SampleSizeCalculator.Splash" parent="Theme.SplashScreen">
        <!-- Background while app is launching -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- Your splash PNG -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_helix</item>

        <!-- Optional fade-out duration -->
        <item name="windowSplashScreenAnimationDuration">400</item>

        <!-- Theme used AFTER splash is done -->
        <item name="postSplashScreenTheme">@style/Theme.SampleSizeCalculator</item>
    </style>

</resources>
